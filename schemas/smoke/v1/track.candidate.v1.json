{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height",
        "confidence"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CandidateInferenceReason": {
      "description": "Operator-safe reason codes for a role receipt.",
      "enum": [
        "none",
        "not_ready",
        "timeout",
        "queue_expired",
        "unavailable",
        "malformed_output",
        "revision_mismatch",
        "deadline_expired",
        "gpu_out_of_memory",
        "provider_error"
      ],
      "title": "CandidateInferenceReason",
      "type": "string"
    },
    "CandidateInferenceReceipt": {
      "additionalProperties": false,
      "description": "Pixels-free receipt for one GPU inference role.",
      "properties": {
        "artifact_revision": {
          "default": "unknown",
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Revision",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "deadline_outcome": {
          "$ref": "#/$defs/DeadlineOutcome",
          "default": "not_applicable"
        },
        "model_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "output_schema": {
          "$ref": "#/$defs/CandidateOutputSchema",
          "default": "none"
        },
        "reason_code": {
          "$ref": "#/$defs/CandidateInferenceReason",
          "default": "none"
        },
        "request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "reviewer": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceReviewerEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "$ref": "#/$defs/CandidateInferenceRole"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "$ref": "#/$defs/CandidateInferenceStatus"
        }
      },
      "required": [
        "role",
        "status",
        "model_revision"
      ],
      "title": "CandidateInferenceReceipt",
      "type": "object"
    },
    "CandidateInferenceRole": {
      "description": "Stable evidence roles emitted by the GPU media plane.",
      "enum": [
        "detector",
        "pose",
        "object",
        "smoke",
        "temporal",
        "reviewer"
      ],
      "title": "CandidateInferenceRole",
      "type": "string"
    },
    "CandidateInferenceStatus": {
      "description": "Bounded receipt states; only ``ok`` can contribute evidence.",
      "enum": [
        "ok",
        "unavailable",
        "timeout",
        "malformed",
        "invalid",
        "revision_mismatch",
        "error",
        "unclear"
      ],
      "title": "CandidateInferenceStatus",
      "type": "string"
    },
    "CandidateOutputSchema": {
      "enum": [
        "none",
        "detector.v1",
        "pose.v1",
        "object.v1",
        "smoke.v1",
        "temporal.v1",
        "reviewer.v1"
      ],
      "title": "CandidateOutputSchema",
      "type": "string"
    },
    "DeadlineOutcome": {
      "enum": [
        "met",
        "expired",
        "not_applicable"
      ],
      "title": "DeadlineOutcome",
      "type": "string"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "coverage_score": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Score",
          "type": "number"
        },
        "person_box": {
          "$ref": "#/$defs/BoundingBox"
        },
        "roi_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roi Id"
        }
      },
      "required": [
        "person_box"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "InferenceReviewerEvidence": {
      "additionalProperties": false,
      "description": "Constrained reviewer output; model prose never crosses the boundary.",
      "properties": {
        "label": {
          "$ref": "#/$defs/ReviewerLabel"
        },
        "reason_code": {
          "$ref": "#/$defs/ReviewerReasonCode"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label",
        "score",
        "reason_code"
      ],
      "title": "InferenceReviewerEvidence",
      "type": "object"
    },
    "ObjectObservation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "enum": [
            "cigarette",
            "vape",
            "phone",
            "cup",
            "food",
            "pen_toothpick",
            "betel_quid",
            "background",
            "unknown"
          ],
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "title": "ObjectObservation",
      "type": "object"
    },
    "Observations": {
      "additionalProperties": false,
      "properties": {
        "independent_channels": {
          "items": {
            "type": "string"
          },
          "title": "Independent Channels",
          "type": "array"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/ObjectObservation"
          },
          "title": "Objects",
          "type": "array"
        },
        "pose": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoseObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviewer": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceReviewerEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "smoke": {
          "anyOf": [
            {
              "$ref": "#/$defs/SmokeObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temporal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Observations",
      "type": "object"
    },
    "PoseObservation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "hand_to_mouth_distance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hand To Mouth Distance"
        },
        "mouth_dwell_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mouth Dwell Ms"
        }
      },
      "required": [
        "confidence"
      ],
      "title": "PoseObservation",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "crop_pixels": {
          "minimum": 0,
          "title": "Crop Pixels",
          "type": "number"
        },
        "eligibility_reason": {
          "title": "Eligibility Reason",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "face_pixels": {
          "minimum": 0,
          "title": "Face Pixels",
          "type": "number"
        },
        "illumination_profile": {
          "enum": [
            "day",
            "night",
            "mixed",
            "unknown"
          ],
          "title": "Illumination Profile",
          "type": "string"
        },
        "source_height": {
          "exclusiveMinimum": 0,
          "title": "Source Height",
          "type": "integer"
        },
        "source_width": {
          "exclusiveMinimum": 0,
          "title": "Source Width",
          "type": "integer"
        }
      },
      "required": [
        "source_width",
        "source_height",
        "face_pixels",
        "crop_pixels",
        "illumination_profile",
        "eligible",
        "eligibility_reason"
      ],
      "title": "Quality",
      "type": "object"
    },
    "ReviewerLabel": {
      "enum": [
        "smoking",
        "not_smoking",
        "unclear"
      ],
      "title": "ReviewerLabel",
      "type": "string"
    },
    "ReviewerReasonCode": {
      "enum": [
        "smoking_behavior",
        "non_smoking_behavior",
        "unclear_view"
      ],
      "title": "ReviewerReasonCode",
      "type": "string"
    },
    "SmokeObservation": {
      "additionalProperties": false,
      "properties": {
        "ember_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ember Score",
          "type": "number"
        },
        "smoke_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Smoke Score",
          "type": "number"
        }
      },
      "required": [
        "smoke_score",
        "ember_score"
      ],
      "title": "SmokeObservation",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "detected",
        "quality",
        "pose",
        "object",
        "temporal",
        "review",
        "completed"
      ],
      "title": "Stage",
      "type": "string"
    },
    "TemporalObservation": {
      "additionalProperties": false,
      "properties": {
        "cycle_interval_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycle Interval Ms"
        },
        "hand_retreat": {
          "title": "Hand Retreat",
          "type": "boolean"
        },
        "persistence_ms": {
          "minimum": 0,
          "title": "Persistence Ms",
          "type": "integer"
        }
      },
      "required": [
        "hand_retreat",
        "persistence_ms"
      ],
      "title": "TemporalObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The ``track.candidate.v1`` message represented as JSON.",
  "properties": {
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "camera_config_revision": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Camera Config Revision",
      "type": "string"
    },
    "camera_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Camera Id",
      "type": "string"
    },
    "capture_ts_ns": {
      "minimum": 0,
      "title": "Capture Ts Ns",
      "type": "integer"
    },
    "correlation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "first_seen_at": {
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/Geometry"
    },
    "inference_receipts": {
      "items": {
        "$ref": "#/$defs/CandidateInferenceReceipt"
      },
      "title": "Inference Receipts",
      "type": "array"
    },
    "last_seen_at": {
      "format": "date-time",
      "title": "Last Seen At",
      "type": "string"
    },
    "model_revisions": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "$ref": "#/$defs/CandidateInferenceRole"
      },
      "title": "Model Revisions",
      "type": "object"
    },
    "observations": {
      "$ref": "#/$defs/Observations"
    },
    "occurred_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurred At"
    },
    "producer": {
      "default": "unknown",
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    },
    "received_ts_ns": {
      "minimum": 0,
      "title": "Received Ts Ns",
      "type": "integer"
    },
    "schema_version": {
      "const": "track.candidate.v1",
      "default": "track.candidate.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_pts_ns": {
      "minimum": 0,
      "title": "Source Pts Ns",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "track_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Track Id",
      "type": "string"
    }
  },
  "required": [
    "camera_id",
    "track_id",
    "camera_config_revision",
    "source_pts_ns",
    "capture_ts_ns",
    "received_ts_ns",
    "first_seen_at",
    "last_seen_at",
    "stage",
    "geometry",
    "quality",
    "observations"
  ],
  "title": "CandidateEnvelope",
  "type": "object"
}
