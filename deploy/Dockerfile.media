# VIDEO-302 media plane. Build one of the explicit targets:
#   docker build --target reference -f deploy/Dockerfile.media .
#   docker build --target deepstream -f deploy/Dockerfile.media \
#     --build-arg DEEPSTREAM_IMAGE=nvcr.io/nvidia/deepstream:7.0-triton-multiarch@sha256:<digest> .
# The DeepStream digest, host driver, and image import receipt are mandatory
# qualification inputs. The default target intentionally contains no NVIDIA SDK.

ARG DEEPSTREAM_IMAGE=nvcr.io/nvidia/deepstream:7.0-triton-multiarch@sha256:c11befa808af8270e8ea0d0d7cc7cabbda08a2f496ee30b95f7acba5dce81759

FROM ubuntu:24.04 AS reference-build
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential ca-certificates cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY native/deepstream /src/native/deepstream
RUN cmake -S native/deepstream -B /tmp/media-build -DBUILD_TESTING=ON \
    && cmake --build /tmp/media-build --parallel \
    && ctest --test-dir /tmp/media-build --output-on-failure

FROM ubuntu:24.04 AS reference
COPY --from=reference-build /tmp/media-build/libmedia_worker.a /opt/smoke-detect/lib/
COPY --from=reference-build /tmp/media-build/media_publisher /opt/smoke-detect/bin/media-publisher
COPY --from=reference-build /src/native/deepstream/include /opt/smoke-detect/include
LABEL org.opencontainers.image.title="tp-smoke-detect media worker (CPU reference)" \
      org.opencontainers.image.description="Bounded media lifecycle and contract reference path"

FROM ${DEEPSTREAM_IMAGE} AS deepstream-build
ARG DEEPSTREAM_SDK_ROOT=/opt/nvidia/deepstream/deepstream
WORKDIR /src
COPY native/deepstream /src/native/deepstream
RUN cmake -S native/deepstream -B /tmp/media-build \
      -DBUILD_TESTING=ON \
      -DTP_SMOKE_DETECT_ENABLE_DEEPSTREAM=ON \
      -DDEEPSTREAM_SDK_ROOT=${DEEPSTREAM_SDK_ROOT} \
    && cmake --build /tmp/media-build --parallel \
    && ctest --test-dir /tmp/media-build --output-on-failure

FROM ${DEEPSTREAM_IMAGE} AS deepstream
COPY --from=deepstream-build /tmp/media-build/libmedia_worker.a /opt/smoke-detect/lib/
COPY --from=deepstream-build /tmp/media-build/media_publisher /opt/smoke-detect/bin/media-publisher
COPY --from=deepstream-build /src/native/deepstream/include /opt/smoke-detect/include
COPY deploy/media-entrypoint.sh /opt/smoke-detect/bin/media-entrypoint
COPY deploy/triton-entrypoint.sh /opt/smoke-detect/bin/triton-entrypoint
COPY deploy/deepstream/rtx3090/config.txt /etc/smoke-detect/deepstream/config.txt
COPY native/deepstream/config /opt/smoke-detect/deepstream/config
COPY scripts/gpu_receipts.py scripts/validate_gpu_receipt.py /opt/smoke-detect/receipt/
# The native publisher uses the distro-supported mosquitto_pub client.  Keep
# it in the same digest-pinned image as the graph so a successful callback can
# actually reach candidate-consumer; never silently fall back to a host tool.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates mosquitto-clients python3 \
    && rm -rf /var/lib/apt/lists/* \
    && chmod 0755 /opt/smoke-detect/bin/media-entrypoint /opt/smoke-detect/bin/triton-entrypoint
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    SMOKE_GPU_MEDIA_CONFIG=/etc/smoke-detect/deepstream/config.txt \
    SMOKE_GPU_MEDIA_EXECUTABLE=/opt/smoke-detect/bin/media-publisher
ENTRYPOINT ["/opt/smoke-detect/bin/media-entrypoint"]
LABEL org.opencontainers.image.title="tp-smoke-detect media worker (DeepStream 7.0)" \
      org.opencontainers.image.description="GPU media plane; RTX 3090 lab row; target qualification required"
